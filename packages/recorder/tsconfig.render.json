{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // node is here because the page's type-only imports reach into src, which
    // does use node APIs. The page itself uses none.
    "types": ["node", "vite/client"],
    "noEmit": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["render-page", "src"]
}
